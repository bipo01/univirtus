{
  "manifest_version": 3,
  "name": "AVA Downloader",
  "short_name": "AVA Downloader",
  "description": "Baixe de uma vez as videoaulas e materiais do AVA Univirtus, organizados por curso, disciplina e aula. Extensão não oficial.",
  "version": "1.3.1",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Baixar minhas aulas",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "scripting",
    "storage",
    "unlimitedStorage",
    "power",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://univirtus.uninter.com/*",
    "https://vod.grupouninter.com.br/*",
    "https://aud.grupouninter.com.br/*",
    "https://univirtuscdn.uninter.com/*",
    "https://www.youtube.com/*",
    "https://*.googlevideo.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://univirtus.uninter.com/ava/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
